# Copy to .env and adjust. NEVER commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=lifeadmin
POSTGRES_USER=lifeadmin
POSTGRES_PASSWORD=lifeadmin
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=lifeadmin
RABBITMQ_DEFAULT_PASS=lifeadmin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=lifeadmin
MINIO_ROOT_PASSWORD=lifeadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=lifeadmin-documents

# --- Mailpit (dev SMTP) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Backend ---
BACKEND_PORT=8080
# JWT signing secret (HS256) — MUST be >= 32 bytes and overridden per environment.
LIFEADMIN_JWT_SECRET=dev-only-insecure-secret-change-me-please-32bytes-minimum!!
LIFEADMIN_JWT_ACCESS_TTL_MINUTES=30
LIFEADMIN_JWT_REFRESH_TTL_DAYS=14
LIFEADMIN_JWT_ISSUER=lifeadmin

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
